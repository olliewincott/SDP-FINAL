        if request.method != "POST":
            return JsonResponse({"error": "Invalid request method"}, status=400)

        data = json.loads(request.body)
        user_message = data.get("message", "").strip()

        if not user_message:
            return JsonResponse({"error": "Empty message"}, status=400)

        # Parse intent and handle accordingly
        intent = parse_intent(user_message)
        if intent:
            action, category, details = intent
            
            if action == 'schedule':
                response = get_schedule_summary()
            elif action == 'wellness':
                response = get_wellness_status()
            elif action == 'analytics':
                response = get_analytics_summary(details)
            elif action == 'event':
                if category == 'add' and details.get('title'):
                    response = create_event(request.user, details['title'], details.get('time', ''))
                else:
                    response = "❌ I couldn't understand the event details. Please try again with a title and time."
            elif action == 'reminder':
                if category == 'add' and details.get('event_title'):
                    response = create_reminder(request.user, details['event_title'], details['reminder_time'])
                else:
                    response = "❌ I couldn't understand the reminder details. Please specify an event and reminder time."
            elif action == 'task':
                if category == 'add' and details.get('title'):
                    response = create_task(request.user, details['title'], details.get('due_date'))
                else:
                    response = "❌ Invalid task details provided."
            else:
                response = "I'm not sure how to help with that. Could you rephrase?"

            return JsonResponse({"response": response})

        # If no specific intent is matched, use OpenAI for general conversation
        system_prompt = (
            "You're an advanced productivity assistant designed to help neurodivergent users "
            "manage tasks, events, and wellbeing. You can:\n"
            "1. Show daily schedule and tasks\n"
            "2. Create events (e.g., 'add event: Meeting from 2 PM to 3 PM')\n"
            "3. Create tasks (e.g., 'add task Review code due tomorrow at 5 PM')\n"
            "4. Set reminders (e.g., 'add reminder for Meeting 30 minutes before')\n"
            "5. Show wellness status and analytics\n"
            "6. Provide productivity tips\n"
            "Be supportive and empathetic in your responses."
        )

        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_message}
        ]

        response = openai.ChatCompletion.create(
            model="gpt-4",
            messages=messages,
            max_tokens=500,
            temperature=0.6
        )
        
        bot_reply = response["choices"][0]["message"]["content"].strip()
        ChatMessage.objects.create(user=request.user, role='assistant', content=bot_reply)
        
        return JsonResponse({"response": bot_reply})

    except Exception as e:
        logger.error(f"Error in chatbot logic: {str(e)}")
        return JsonResponse({"error": f"An error occurred: {str(e)}"}, status=500)
    
