            return request.user.first_name
        return "Ollie"  # Default to Ollie since we know the username

    def parse_time_string(time_str):
        """Parse time string and return start and end datetime objects"""
        now = timezone_now()
        today = now.date()

        # Parse different time formats
        time_patterns = [
            # Format: 2 PM to 3 PM or 2 PM - 3 PM
            r"(\d{1,2})(?::(\d{2}))?\s*(am|pm|AM|PM)?\s*(?:to|-)\s*(\d{1,2})(?::(\d{2}))?\s*(am|pm|AM|PM)?",
            # Format: at 2 PM for 1 hour
            r"(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm|AM|PM)?\s*(?:for\s+(\d+)\s+(?:hour|hr|hours|hrs))"
        ]

        for pattern in time_patterns:
            match = re.search(pattern, time_str)
            if match:
                groups = match.groups()
                if len(groups) == 6:  # First pattern (start and end time)
                    start_hour = int(groups[0])
                    start_minute = int(groups[1]) if groups[1] else 0
                    start_ampm = groups[2].lower() if groups[2] else 'pm'
                    end_hour = int(groups[3])
                    end_minute = int(groups[4]) if groups[4] else 0
                    end_ampm = groups[5].lower() if groups[5] else start_ampm

                    # Convert to 24-hour format
                    if start_ampm == 'pm' and start_hour != 12:
                        start_hour += 12
                    elif start_ampm == 'am' and start_hour == 12:
                        start_hour = 0

                    if end_ampm == 'pm' and end_hour != 12:
                        end_hour += 12
                    elif end_ampm == 'am' and end_hour == 12:
                        end_hour = 0

                    start_datetime = make_aware(datetime.combine(today, datetime.min.time().replace(hour=start_hour, minute=start_minute)))
                    end_datetime = make_aware(datetime.combine(today, datetime.min.time().replace(hour=end_hour, minute=end_minute)))

                    # If end time is before start time, assume it's for the next day
                    if end_datetime <= start_datetime:
                        end_datetime += timedelta(days=1)

                    return start_datetime, end_datetime

                elif len(groups) == 4:  # Second pattern (start time and duration)
                    start_hour = int(groups[0])
                    start_minute = int(groups[1]) if groups[1] else 0
                    start_ampm = groups[2].lower() if groups[2] else 'pm'
                    duration_hours = int(groups[3])

                    # Convert to 24-hour format
                    if start_ampm == 'pm' and start_hour != 12:
                        start_hour += 12
                    elif start_ampm == 'am' and start_hour == 12:
                        start_hour = 0

                    start_datetime = make_aware(datetime.combine(today, datetime.min.time().replace(hour=start_hour, minute=start_minute)))
                    end_datetime = start_datetime + timedelta(hours=duration_hours)

                    return start_datetime, end_datetime

        return None, None
    def parse_reminder_time(reminder_str):
        """Parse reminder time string and return timedelta"""
        reminder_patterns = [
            r"(\d+)\s*(minute|minutes|min|mins)",
            r"(\d+)\s*(hour|hours|hr|hrs)",
            r"(\d+)\s*(day|days)"
        ]

        for pattern in reminder_patterns:
            match = re.search(pattern, reminder_str.lower())
            if match:
                amount = int(match.group(1))
                unit = match.group(2)
                
                if unit.startswith('minute'):
                    return timedelta(minutes=amount)
                elif unit.startswith('hour'):
                    return timedelta(hours=amount)
                elif unit.startswith('day'):
                    return timedelta(days=amount)
        
        return None

    def parse_intent(text):
        text = text.lower()

        # Schedule and Calendar Intents
        if any(phrase in text for phrase in [
            "schedule", "what do i have", "what's planned", "what is planned",
            "show me my day", "tell me my day"
        ]) and not any(phrase in text for phrase in ["add", "create", "schedule an"]):
            return ('schedule', 'view', 'today')

        # Event Creation Intent
        event_patterns = [
            r"(?:add|create|schedule)\s+(?:an?\s+)?event:?\s*(.*?)(?:\s+(?:from|at|time:?)\s+(.*)|$)",
            r"(?:add|create|schedule)\s+(?:an?\s+)?appointment:?\s*(.*?)(?:\s+(?:from|at|time:?)\s+(.*)|$)"
        ]
        
        for pattern in event_patterns:
            event_match = re.match(pattern, text, re.IGNORECASE)
            if event_match:
                title, time_str = event_match.groups()
                return ('event', 'add', {
                    'title': title.strip(),
                    'time': time_str.strip() if time_str else None
                })

        # Reminder Creation Intent
        reminder_match = re.search(r"(?:add|create|set)\s+(?:a\s+)?reminder\s+(?:for\s+)?(.*?)(?:\s+(\d+)\s*(?:minute|hour|day)s?\s+(?:before|ahead))", text)
        if reminder_match:
            event_title, reminder_time = reminder_match.groups()
            return ('reminder', 'add', {
                'event_title': event_title.strip(),
                'reminder_time': reminder_time.strip()
            })

        # Task Management Intents
        task_match = re.match(r".*(add|create)\s+task\s+(.*?)(?:\s+due\s+(.*)|$)", text)
        if task_match:
            action, title, due_date = task_match.groups()
            return ('task', 'add', {'title': title, 'due_date': due_date})

        # Wellness and Analytics Intents
        if "wellness" in text or "wellbeing" in text or "how am i doing" in text:
            return ('wellness', 'status', None)
        
        if "analytics" in text or "statistics" in text or "progress" in text:
            period_match = re.search(r"(last|past)\s+(\d+)\s+(day|days|week|weeks|month|months)", text)
            if period_match:
                _, num, unit = period_match.groups()
                return ('analytics', 'view', f"{num} {unit}")
            return ('analytics', 'view', '7 days')

        return None

    def create_event(user, title, time_str):
        """Create a new calendar event"""
        try:
            if not time_str:
                return "❌ Please specify a time for the event (e.g., 'from 2 PM to 3 PM' or 'at 3 PM for 1 hour')"

            start_datetime, end_datetime = parse_time_string(time_str)
            
            if not start_datetime or not end_datetime:
                return "❌ I couldn't understand the time format. Please use format like '2 PM to 3 PM' or 'at 2 PM for 1 hour'"

            # Create the event
            event = CalendarEvent.objects.create(
                user=user,
                title=title,
                start_time=start_datetime,
                end_time=end_datetime
            )

            # Format response
            start_time_str = start_datetime.strftime("%I:%M %p")
            end_time_str = end_datetime.strftime("%I:%M %p")
            
            return (
                f"✅ Event '{title}' scheduled!\n"
                f"📅 Time: {start_time_str} - {end_time_str}\n"
                f"🎯 I've added this to your calendar. Would you like me to set any reminders?"
            )

        except Exception as e:
            logger.error(f"Error creating event: {str(e)}")
            return "❌ Sorry, I couldn't create the event. Please try again with a different format."

    def create_reminder(user, event_title, reminder_time_str):
        """Create a reminder for an existing event"""
        try:
            # Find the most recent future event matching the title
            event = CalendarEvent.objects.filter(
                user=user,
                title__icontains=event_title,
                start_time__gte=timezone_now()
            ).order_by('start_time').first()

            if not event:
                return f"❌ I couldn't find any upcoming events with the title '{event_title}'"

            # Parse reminder time
            reminder_delta = parse_reminder_time(reminder_time_str)
            if not reminder_delta:
                return "❌ I couldn't understand the reminder time. Please specify like '30 minutes' or '1 hour'"

            reminder_time = event.start_time - reminder_delta

            # Check if reminder is in the past
            if reminder_time <= timezone_now():
                return "❌ This reminder time would be in the past. Please choose a future time."

            # Create the reminder
            reminder = Reminder.objects.create(
                event=event,
                reminder_time=reminder_time
            )

            # Format response
            reminder_time_str = reminder_time.strftime("%I:%M %p")
            event_time_str = event.start_time.strftime("%I:%M %p")
            
            return (
                f"✅ Reminder set for '{event.title}'!\n"
                f"🔔 You'll be reminded at {reminder_time_str} "
                f"({reminder_time_str} before the event at {event_time_str})"
            )

        except Exception as e:
            logger.error(f"Error creating reminder: {str(e)}")
            return "❌ Sorry, I couldn't set the reminder. Please try again."

    def create_task(user, title, due_date_str=None):
        """Create a new task"""
        try:
            due_date = None
            if due_date_str:
                # Try to parse different date formats
                date_patterns = [
                    r"today at (\d{1,2})(?::(\d{2}))?\s*(am|pm|AM|PM)",
                    r"tomorrow at (\d{1,2})(?::(\d{2}))?\s*(am|pm|AM|PM)",
                    r"(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})"
                ]

                for pattern in date_patterns:
                    match = re.search(pattern, due_date_str)
                    if match:
                        if "today at" in due_date_str:
                            hour = int(match.group(1))
                            minute = int(match.group(2)) if match.group(2) else 0
                            ampm = match.group(3).lower()
                            
                            if ampm == 'pm' and hour != 12:
                                hour += 12
                            elif ampm == 'am' and hour == 12:
                                hour = 0
                                
                            due_date = timezone_now().replace(
                                hour=hour,
                                minute=minute,
                                second=0,
                                microsecond=0
                            )
                        elif "tomorrow at" in due_date_str:
                            hour = int(match.group(1))
                            minute = int(match.group(2)) if match.group(2) else 0
                            ampm = match.group(3).lower()
                            
                            if ampm == 'pm' and hour != 12:
                                hour += 12
                            elif ampm == 'am' and hour == 12:
                                hour = 0
                                
                            due_date = (timezone_now() + timedelta(days=1)).replace(
                                hour=hour,
                                minute=minute,
                                second=0,
                                microsecond=0
                            )
                        else:
                            due_date = make_aware(datetime.strptime(
                                f"{match.group(1)} {match.group(2)}", 
                                "%Y-%m-%d %H:%M"
                            ))
                        break

            # Create the task
            task = Task.objects.create(
                user=user,
                title=title,
                due_date=due_date
            )

            # Format response
            response = f"✅ Task '{title}' created successfully!"
            if due_date:
                response += f"\n⏰ Due: {due_date.strftime('%I:%M %p on %B %d, %Y')}"
            
            return response

        except Exception as e:
            logger.error(f"Error creating task: {str(e)}")
            return "❌ Sorry, I couldn't create the task. Please try again with a different format."
        
    def format_time_period(current_time):
        """Return appropriate greeting based on time of day"""
        hour = current_time.hour
        if 5 <= hour < 12:
            return "morning"
        elif 12 <= hour < 17:
            return "afternoon"
        elif 17 <= hour < 21:
            return "evening"
        else:
            return "night"

    def create_progress_bar(current, target, width=10):
        """Create a visual progress bar"""
        filled = int((current/target) * width) if target > 0 else 0
        return "▓" * filled + "░" * (width - filled)

