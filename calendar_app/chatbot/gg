            parts.extend([
                "\n🌟 Wellness Achievements:",
                f"  Daily Goals: {wellness_bar} {goals_rate:.1f}%",
                f"  • Met all goals on {goals_met_days}/{days} days",
                "\n  Daily Averages:",
                f"  • 💧 Water: {avg_water:.1f} glasses",
                f"  • 🏃 Movement: {avg_breaks:.1f} breaks",
                f"  • 🍎 Meals: {avg_meals:.1f} healthy meals"
