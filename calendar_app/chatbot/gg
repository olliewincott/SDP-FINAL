        if any([morning_events, afternoon_events, evening_events]):
            parts.append("\n📅 Your Schedule:")
            
            if morning_events:
                parts.append("\n  🌅 Morning:")
                for event in morning_events:
                    status = "✅" if event.end_time < now else "🟢" if event.start_time <= now <= event.end_time else "⏳"
                    time_str = f"{event.start_time.strftime('%I:%M %p')} - {event.end_time.strftime('%I:%M %p')}"
                    parts.append(f"    {status} {event.title} ({time_str})")

            if afternoon_events:
                parts.append("\n  ☀️ Afternoon:")
                for event in afternoon_events:
                    status = "✅" if event.end_time < now else "🟢" if event.start_time <= now <= event.end_time else "⏳"
                    time_str = f"{event.start_time.strftime('%I:%M %p')} - {event.end_time.strftime('%I:%M %p')}"
                    parts.append(f"    {status} {event.title} ({time_str})")

            if evening_events:
                parts.append("\n  🌙 Evening:")
                for event in evening_events:
                    status = "✅" if event.end_time < now else "🟢" if event.start_time <= now <= event.end_time else "⏳"
                    time_str = f"{event.start_time.strftime('%I:%M %p')} - {event.end_time.strftime('%I:%M %p')}"
                    parts.append(f"    {status} {event.title} ({time_str})")

        # Tasks section
        if tasks:
            parts.append("\n📝 Tasks for Today:")
            completed_tasks = [t for t in tasks if t.completed]
            pending_tasks = [t for t in tasks if not t.completed]

            if pending_tasks:
                parts.append("  To Do:")
                for task in pending_tasks:
                    time_str = task.due_date.strftime("%I:%M %p") if task.due_date else "No time set"
                    parts.append(f"    ⏳ {task.title} (Due: {time_str})")

            if completed_tasks:
                parts.append("  Completed:")
                for task in completed_tasks:
                    parts.append(f"    ✅ {task.title}")

        # Reminders section
        upcoming_reminders = [r for r in reminders if r.reminder_time > now - timedelta(hours=1)]
        if upcoming_reminders:
            parts.append("\n🔔 Don't Forget:")
            for reminder in upcoming_reminders:
                time_str = reminder.reminder_time.strftime("%I:%M %p")
                time_diff = reminder.reminder_time - now
                if time_diff > timedelta(0):
                    minutes = int(time_diff.total_seconds() / 60)
                    if minutes < 60:
                        time_info = f"in {minutes} minutes"
                    else:
                        hours = minutes // 60
                        time_info = f"in {hours} hour{'s' if hours > 1 else ''}"
                else:
                    time_info = "now"
                parts.append(f"    ⏳ {reminder.event.title} ({time_info})")

        # Add a summary at the end
        remaining_events = len([e for e in events if e.end_time > now])
        remaining_tasks = len([t for t in tasks if not t.completed])
        if remaining_events + remaining_tasks > 0:
            summary = []
            if remaining_events:
                summary.append(f"{remaining_events} event{'s' if remaining_events > 1 else ''}")
            if remaining_tasks:
                summary.append(f"{remaining_tasks} task{'s' if remaining_tasks > 1 else ''}")
            parts.append(f"\n💪 Coming up: {' and '.join(summary)}. You've got this!")
        else:
            parts.append("\n🌟 Great job! You've completed everything for today!")

        return "\n".join(parts)
    
    def get_wellness_status():
        """Get the user's wellness status and progress"""
        user = request.user
        today = timezone_now().date()
        current_time = timezone_now().strftime("%I:%M %p")
        user_name = get_user_first_name()
        time_period = format_time_period(timezone_now())

        wellness, _ = DailyWellness.objects.get_or_create(user=user, date=today)
        
        # Calculate streak
        streak = 0
        streak_date = today - timedelta(days=1)
        while True:
            try:
                entry = DailyWellness.objects.get(user=user, date=streak_date)
                if not entry.goal_completed:
                    break
                streak += 1
                streak_date -= timedelta(days=1)
            except DailyWellness.DoesNotExist:
                break

        # Get recent mood entries
        recent_moods = MoodEntry.objects.filter(
            user=user,
            timestamp__date__gte=today - timedelta(days=7)
        ).order_by('-timestamp')[:5]

        parts = [f"👋 Good {time_period}, {user_name}! Here's how you're doing today (as of {current_time}):"]

        # Wellness Progress with visual bars
        parts.append("\n🎯 Today's Progress:")
        water_bar = create_progress_bar(wellness.water_intake, wellness.water_goal)
        breaks_bar = create_progress_bar(wellness.movement_breaks, wellness.breaks_goal)
        meals_bar = create_progress_bar(wellness.healthy_meals, wellness.meals_goal)

        parts.extend([
            f"  💧 Water: {water_bar} {wellness.water_intake}/{wellness.water_goal} glasses" +
            (" ✨" if wellness.water_intake >= wellness.water_goal else ""),
            f"  🏃 Movement: {breaks_bar} {wellness.movement_breaks}/{wellness.breaks_goal} breaks" +
            (" ✨" if wellness.movement_breaks >= wellness.breaks_goal else ""),
            f"  🍎 Meals: {meals_bar} {wellness.healthy_meals}/{wellness.meals_goal} healthy meals" +
            (" ✨" if wellness.healthy_meals >= wellness.meals_goal else "")
        ])

        # XP Progress bar
        xp_bar = create_progress_bar(wellness.xp, 100, width=15)
        parts.extend([
            "\n🌟 Achievements:",
            f"  🔥 Streak: {streak} days{'!' if streak > 5 else ''}",
            f"  ⭐ Level {wellness.level}",
            f"  ✨ XP: {xp_bar} {wellness.xp}/100"
        ])

        # Mood Trend with emojis and dates
        if recent_moods.exists():
            parts.append("\n😊 Recent Mood Pattern:")
            for mood in recent_moods:
                mood_emoji = "😊" if mood.mood_rating >= 4 else "😐" if mood.mood_rating >= 2 else "😔"
                date_str = mood.timestamp.strftime("%a, %b %d")
                rating_bar = "★" * mood.mood_rating + "☆" * (5 - mood.mood_rating)
                parts.append(f"  {mood_emoji} {date_str}: {rating_bar}")

        # Add encouraging message based on progress
        total_goals = 3
        met_goals = sum([
            wellness.water_intake >= wellness.water_goal,
            wellness.movement_breaks >= wellness.breaks_goal,
            wellness.healthy_meals >= wellness.meals_goal
        ])

        if met_goals == total_goals:
            parts.append("\n🎉 Fantastic work! You've hit all your wellness goals for today!")
        elif met_goals > 0:
            parts.append(f"\n💪 You're making great progress! {met_goals}/{total_goals} goals completed.")
            remaining = total_goals - met_goals
            parts.append(f"Just {remaining} more to go - you've got this!")
        else:
            parts.append("\n💫 Remember: every small step counts. Let's work on those wellness goals!")
            if timezone_now().hour < 12:
                parts.append("The day is still young - you've got plenty of time!")

        return "\n".join(parts)

    def get_analytics_summary(period_spec):
        """Generate analytics summary for the specified period"""
        try:
            user_name = get_user_first_name()
            parts = period_spec.split()
            num = int(parts[0])
            unit = parts[1].lower()
            
            if unit in ['week', 'weeks']:
                days = num * 7
                period_name = f"{num} week{'s' if num > 1 else ''}"
            elif unit in ['month', 'months']:
                days = num * 30
                period_name = f"{num} month{'s' if num > 1 else ''}"
            else:
                days = num
                period_name = f"{num} day{'s' if num > 1 else ''}"

            start_date = timezone_now().date() - timedelta(days=days)
            user = request.user

            # Task completion stats
            total_tasks = Task.objects.filter(
                user=user,
                due_date__date__gte=start_date
            ).count()
            
            completed_tasks = Task.objects.filter(
                user=user,
                due_date__date__gte=start_date,
                completed=True
            ).count()

            # Event attendance
            events = CalendarEvent.objects.filter(
                user=user,
                start_time__date__gte=start_date
            )
            
            total_events = events.count()
            total_event_hours = sum(
                (event.end_time - event.start_time).total_seconds() / 3600 
                for event in events
            )

            # Wellness achievements
            wellness_entries = DailyWellness.objects.filter(
                user=user,
                date__gte=start_date
            )
            
            goals_met_days = wellness_entries.filter(goal_completed=True).count()
            
            # Calculate averages
            total_entries = wellness_entries.count()
            if total_entries > 0:
                avg_water = sum(entry.water_intake or 0 for entry in wellness_entries) / total_entries
                avg_breaks = sum(entry.movement_breaks or 0 for entry in wellness_entries) / total_entries
                avg_meals = sum(entry.healthy_meals or 0 for entry in wellness_entries) / total_entries
            else:
                avg_water = avg_breaks = avg_meals = 0

            completion_rate = (completed_tasks / total_tasks * 100) if total_tasks > 0 else 0
            goals_rate = (goals_met_days / days * 100)

            # Create progress bars
            def create_progress_bar(percentage, width=20):
                filled = int((percentage/100) * width)
                return "▓" * filled + "░" * (width - filled)

